# E-mail delivery via Resend (https://resend.com/api-keys). Copy to .env.local locally,
# on Vercel add the same variables under Environment Variables (Production).
RESEND_API_KEY=re_xxxxxxxxx
# Where form leads go and who they are sent from. The sender domain must be verified in Resend.
CONTACT_TO=maros.smrek@thunderstruck.studio
CONTACT_FROM="Alma ADOS <maros.smrek@thunderstruck.studio>"

# Public site origin (canonical URL, OG image). Defaults to https://adosalma.sk in production.
NEXT_PUBLIC_SITE_URL=https://adosalma.sk

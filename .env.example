# SMTP pre odosielanie formulára (nodemailer). Skopíruj do .env.local a doplň.
# Gmail: zapni 2FA a vytvor „Heslo aplikácie" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=maros.smrek@thunderstruck.studio
SMTP_PASS=heslo-aplikacie
# Kam chodia záujmy z formulára a odosielateľ
CONTACT_TO=maros.smrek@thunderstruck.studio
CONTACT_FROM="Alma ADOS <maros.smrek@thunderstruck.studio>"

# Verejná adresa webu (pre OG obrázok pri zdieľaní). Na Verceli sa inak použije VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://alma.sk
